
import random
import time


class Planet:
    def __init__(self, name, survival_chance, exp_gain, metals, secret):
        self.name = name
        self.survival_chance = survival_chance
        self.exp_gain = exp_gain
        self.metals = metals
        self.secret = secret


class Ship:
    def __init__(self, exp, metals, speed, shield, extraction):
        self.exp = exp
        self.speed = speed
        self.shield = shield
        self.extraction = extraction
        self.metals = metals

    def upgrading_ship(self):

        RED = "\033[91m"
        GREEN = "\033[92m"
        BLUE = "\033[94m"
        BOLD = "\033[1m"
        RESET = "\033[0m"

        while True:
            time.sleep(1)
            current_level = self.exp // 100
            speed_upgrade_cost = int(2**self.speed)
            shield_upgrade_cost = int(2**(self.shield / 10))
            extraction_upgrade_cost = int(2**self.extraction)

            if self.metals > min(speed_upgrade_cost, shield_upgrade_cost, extraction_upgrade_cost):

                print(f"\nCurrent level is {GREEN}{current_level}{RESET}")
                print(
                    f"Your ships thrusters are level {BLUE}{self.speed}{RESET}, next level costs {speed_upgrade_cost} metal")
                print(
                    f"Your current shields have a capacity of {BLUE}{self.shield}{RESET}, next level costs {shield_upgrade_cost} metal")
                print(
                    f"Your current mining tech is level {BLUE}{self.extraction}{RESET}, next level costs {extraction_upgrade_cost} metal")

                upgrading = input(
                    f"\n You have {self.metals:.1f} metals, what do you want to upgrade? {BOLD} (thrusters, shields, mining) {RESET}"
                    f"\n or type {BOLD}exit{RESET} if you want to get back to exploring: "
                ).lower()

                if upgrading == 'exit':
                    break

                elif upgrading == 'thrusters':
                    if self.metals >= speed_upgrade_cost:
                        self.speed += 1
                        self.metals -= speed_upgrade_cost
                        print(f"Upgraded thrusters to level {self.speed}!")
                    else:
                        print("You dont have enough metals, go do something else!")

                elif upgrading == 'shields':
                    if self.metals >= shield_upgrade_cost:
                        self.shield += 10
                        self.metals -= shield_upgrade_cost
                        print(f"Upgraded shields to capacity {self.shield}!")
                    else:
                        print("You dont have enough metals, go do something else!")

                elif upgrading == 'mining':
                    if self.metals >= extraction_upgrade_cost:
                        self.extraction += 1
                        self.metals -= extraction_upgrade_cost
                        print(
                            f"Upgraded mining tech to level {self.extraction}!")
                    else:
                        print("You dont have enough metals, go do something else!")

                else:
                    print(
                        f"{RED}Invalid choice, please select thrusters, shields, mining, or exit. {RED}")
            else:
                break

        return self


def leaderboard(ship, trips, result, filename="leaderboard.txt", top_n=5):
    level = ship.exp // 100
    player_name = input("\nEnter your name for the leaderboard: ").strip()

    with open(filename, "a") as f:
        f.write(f"{player_name},{level},{trips}\n")

    entries = []
    try:
        with open(filename, "r") as f:
            for line in f:
                if "," in line:
                    if result == True:
                        name, level_past, trips_past = line.strip().split(",", 2)
                        entries.append((f"{name}_win", float(
                            level_past), float(trips_past)))
                    else:
                        name, level_past, trips_past = line.strip().split(",", 2)
                        entries.append((name, float(
                            level_past), float(trips_past)))
    except FileNotFoundError:
        print("Error: Could not read leaderboard file.")
        return

    entries.sort(key=lambda item: item[1], reverse=True)

    top_name, top_score, longest_trip = entries[0]

    print("\n=========================================================")
    print(
        f"🏆 ALL-TIME HIGH SCORE: {top_name} - Level {top_score} - Planets Visited {longest_trip}")
    print("===========================================================")
    print(f"--- TOP {min(top_n, len(entries))} LEADERBOARD ---")

    for rank, (name, level_past, trips_past) in enumerate(entries[:top_n], start=1):
        print(f"{rank}. {name:<15} - Level {level_past} - Planets Visited {trips_past}")

    print("==========================================================\n")


