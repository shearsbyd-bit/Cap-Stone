        f"  {BOLD}• EXTRACTION [Level {BLUE}{ship.extraction}{RESET}{BOLD}]:{RESET} Enhances mining tech. Boosts the amount")
    print(f"    of bonus resources and rewards harvested from every successful mission.\n")

    print(f"  {YELLOW}★ Finally look out for any secret co-ordinates that may lead us back to Earth !!!{RESET}")
    print(f"{CYAN}==========================================================================={RESET}\n")


def generate_planets(ship, secret_coords, found_coords, trips):

    YELLOW = "\033[93m"
    BOLD = "\033[1m"
    RESET = "\033[0m"

    PREFIXES = ["K2", "KMT", "TOI", "WASP", "Kepler"]
    DESIGNATIONS = ["Prime", "Major", "Minor", "Alpha", "Beta", "Gamma"]

    planets = []

    for i in range(0, 3):
        level = ship.exp // 100

        prefix = random.choice(PREFIXES)
        number = random.randint(1, 1000)
        designation = random.choice(DESIGNATIONS)
        name = f"{prefix}-{number} {designation}"

        min_chance = max(0, 98 - (trips * 8))
        max_chance = max(50, 97 - (trips * 2))
        base_survival = random.uniform(min_chance, max_chance)
        shield_bonus = (ship.shield // 10) * 5
        survival_chance = min(100, base_survival + shield_bonus)

        boost = random.randint(1, 10)
        exp_gain = (10) * ((120-survival_chance) * boost) / 20
        metals = (level + 5) * (ship.extraction) * \
            (survival_chance/100) * (10 - (boost/2)) / 20

        if boost <= 1.3 and len(found_coords) < len(secret_coords):
            secret = secret_coords[len(found_coords)]
        else:
            secret = None

        planets.append(Planet(name, survival_chance, exp_gain, metals, secret))

        secret_text = f" {YELLOW} [SECRET SIGNAL DETECTED!] {RESET}" if secret else ""

        print(
            f"Planet {i+1}: {name} (Survival Chance: {base_survival:.1f} + \033[94m{shield_bonus:.1f}% \033[0m, Experienced: {exp_gain:.1f}, Metals {metals:.1f}){secret_text}"
        )

    choice = int(
        input(f"\n Which planet do you want to visit? {BOLD}(Enter number 1-3):{BOLD} "))
    chosen_planet = planets[choice - 1]

    if chosen_planet:
        print(f"\nHeading to {chosen_planet.name}!")
        return chosen_planet
    else:
        print("\nInvalid choice, defaulted to Option 1.")
        return planets[0]


def planet_interaction(ship, chosen_planet, found_coords, trips):

    YELLOW = "\033[93m"
    GREEN = "\033[92m"
    RED = "\033[91m"
    BOLD = "\033[1m"
    RESET = "\033[0m"

    time.sleep(2)
    level = ship.exp // 100
    if random.randint(0, 100) > chosen_planet.survival_chance:
        chance = 5 * ship.speed
        print(
            f"\n{RED}The mission has went wrong, your ship is about to explode! {RESET}")
        print(
            f"{BOLD}You try to escape using your level {ship.speed} thrusters which has a {chance}% of working: {RESET}")
        time.sleep(2)
        if random.randint(0, 100) > chance:
            print(f"\n {BOLD} The escape failed :( GAME OVER {RESET}")
            print("============================================")
            print(
                f"You made it to level {level:.1f} and visited {trips} different planets. ")
            game = False
        else:
            print("{GREEN} You were lucky to escape this time...{RESET} ")
            game = True

    elif chosen_planet.survival_chance / 2 < random.randint(0, 100) < chosen_planet.survival_chance:
        print("\nYou survived the mission :) ")
        print(
            f" {BOLD} You received {chosen_planet.exp_gain:.1f} experience and {chosen_planet.metals:.1f} metals. {RESET}")
        ship.exp += chosen_planet.exp_gain
        ship.metals += chosen_planet.metals
        game = True

    else:
        bonus = random.uniform(0.2, 0.5)
        print(
            f"\nThis mission went amazigly :) so you received {chosen_planet.exp_gain:.1f} experience and {chosen_planet.metals:.1f} metals")
        print(
            f"{BOLD}{GREEN}You even found some ruins to get an additional {bonus*100:.1f}% rewards: {RESET}")

        ship.exp += (1 + bonus) * chosen_planet.exp_gain
        ship.metals += (1 + bonus) * chosen_planet.metals
        game = True

    # Check for secret coordinate collection if mission survived
    if game and chosen_planet.secret:
        found_coords.append(chosen_planet.secret)
        print(
            f"\n {YELLOW} ★ SECRET DISCOVERED! You recovered coordinate piece: {chosen_planet.secret} {RESET}")
        print(
            f" {YELLOW} Progress: {' - '.join(found_coords)} ({len(found_coords)}/3) {RESET}")

        if len(found_coords) == 3:
            time.sleep(2)
            print("\n==================================================")
            print(f" {BOLD}{YELLOW}★ SECRET ENDING UNLOCKED! ★ {RESET}")
            print(
                f"With coordinates {' - '.join(found_coords)} aligned, you open an ancient wormhole...")
            print(
                "Your ship arrives back at Earth and you dont have to die :D")
            print(f"{BOLD}{GREEN}YOU WIN THE GAME!{BOLD}{RESET}")
            print("==================================================")
            game = False

    return game


if __name__ == "__main__":
    my_ship = Ship(exp=100, metals=0, speed=1, shield=10, extraction=1)

    # Generate secret 3-part coordinates at start
    secret_coords = [str(random.randint(1000, 9999)) for _ in range(3)]
    found_coords = []

    initial_explanation(my_ship)
    game = True
    trips = 0
    while game == True:
        trips += 1
        chosen_planet = generate_planets(
            my_ship, secret_coords, found_coords, trips)
        game = planet_interaction(
            my_ship, chosen_planet, found_coords, trips)
        if game == True:
            my_ship.upgrading_ship()
