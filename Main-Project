def generate_planets(ship, secret_coords, found_coords, trips):

    YELLOW = "\033[93m"
    GREEN = "\033[92m"
    RED = "\033[91m"
    BLUE = "\033[94m"
    BOLD = "\033[1m"
    RESET = "\033[0m"

    PREFIXES = ["K2", "KMT", "TOI", "WASP", "Kepler"]
    DESIGNATIONS = ["Prime", "Major", "Minor", "Alpha", "Beta", "Gamma"]

    planets = []
    level = ship.exp // 100

    print("=========================================================\n")
    for i in range(3):

        min_chance = max(-10, 90 - (trips * 8))
        max_chance = max(30, 97 - (trips * 2))
        base_survival = random.uniform(min_chance, max_chance)

        shield_bonus = 40 * (1 - 0.9**(ship.shield//10))
        level_bonus = 20 - (18 * (0.95 ** (level - 1)))

        survival_chance = min(100, base_survival + shield_bonus + level_bonus)

        danger_factor = (100 - survival_chance) / 100
        risk_multiplier = 1.0 + (danger_factor * 5)

        base_exp = ((15 + (trips)) * risk_multiplier) * 1.5
        exp_gain = base_exp * random.uniform(0.5, 2)

        base_metals = ((2.5 + level) * (ship.extraction + 1)
                       * risk_multiplier) / 8
        metals = base_metals * random.uniform(0.5, 2)

        boost = random.uniform(0, 100)
        if boost <= 5 and len(found_coords) < len(secret_coords):
            secret = secret_coords[len(found_coords)]
        else:
            secret = None

        planets.append(Planet(f"{random.choice(PREFIXES)}-{random.randint(1, 1000)} {random.choice(DESIGNATIONS)}",
                              survival_chance, exp_gain, metals, secret))

        if survival_chance > 80:
            danger_color = {GREEN}
        elif survival_chance > 50:
            danger_color = {YELLOW}
        else:
            danger_color = {RED}

        secret_text = f" {YELLOW}[SECRET SIGNAL DETECTED!]{RESET}" if secret else ""

        print(
            f"  • Planet {i+1}: {planets[i].name} with a "
            f"Survival chance {base_survival+level_bonus:.1f}% + {BLUE}+{shield_bonus:.1f}%{RESET})\n"
            f"  • Rewards: {planets[i].exp_gain:.1f} EXP | {planets[i].metals:.1f} Metals{secret_text}\n"
        )
    while True:
        choice = input(
            "Which planet do you want to visit? (Enter number 1-3): ")
        if choice in ['1', '2', '3']:
            break
        else:
            continue

    return planets[int(choice) - 1]


def planet_interaction(ship, chosen_planet, found_coords, trips):

    YELLOW = "\033[93m"
    GREEN = "\033[92m"
    RED = "\033[91m"
    BOLD = "\033[1m"
    RESET = "\033[0m"
    result = False

    time.sleep(2)
    level = ship.exp // 100
    if random.randint(0, 100) > chosen_planet.survival_chance:
        chance = 5 * ship.speed
        print(
            f"\n{RED}The mission has went wrong, your ship is about to explode! {RESET}")
        print(
            f"{BOLD}You try to escape using your level {ship.speed} thrusters which has a {chance}% of working: {RESET}")
        time.sleep(2)
        if random.randint(0, 100) > chance:
            print(f"\n {BOLD} The escape failed :( GAME OVER {RESET}")
            print("=========================================================")
            print(
                f"You made it to level {level:.1f} and visited {trips} different planets. ")
            game = False
        else:
            print(f"{GREEN} You were lucky to escape this time...{RESET} \n")
            game = True

    elif chosen_planet.survival_chance / 2 < random.randint(0, 100) < chosen_planet.survival_chance:
        print("\nYou survived the mission :) ")
        print(
            f" {BOLD} You received {chosen_planet.exp_gain:.1f} experience and {chosen_planet.metals:.1f} metals. {RESET}")
        ship.exp += chosen_planet.exp_gain
        ship.metals += chosen_planet.metals
        game = True

    else:
        bonus = random.uniform(0.2, 0.5)
        print(
            f"\nThis mission went amazingly :) so you received {chosen_planet.exp_gain:.1f} experience and {chosen_planet.metals:.1f} metals")
        print(
            f"{BOLD}{GREEN}You even found some ruins to get an additional {bonus*100:.1f}% rewards: {RESET}\n")

        ship.exp += (1 + bonus) * chosen_planet.exp_gain
        ship.metals += (1 + bonus) * chosen_planet.metals
        game = True

    # Check for secret coordinate collection if mission survived
    if game and chosen_planet.secret:
        found_coords.append(chosen_planet.secret)
        print(
            f"\n {YELLOW} ★ SECRET DISCOVERED! You recovered coordinate piece: {chosen_planet.secret} {RESET}")
        print(
            f" {YELLOW} Progress: {' - '.join(found_coords)} ({len(found_coords)}/3) {RESET}")

        if len(found_coords) == 3:
            time.sleep(2)
            print("\n=========================================================")
            print(f" {BOLD}{YELLOW}★ SECRET ENDING UNLOCKED! ★ {RESET}")
            print(
                f"With coordinates {' - '.join(found_coords)} aligned, you open an ancient wormhole...")
            print(
                "Your ship arrives back at Earth and you dont have to die :D")
            print(f"{BOLD}{GREEN}YOU WIN THE GAME!{BOLD}{RESET}")
            print("=========================================================")
            game = False
            result = True

    return game, result


if __name__ == "__main__":
    my_ship = Ship(exp=100, metals=0, speed=1, shield=10, extraction=1)

    secret_coords = [str(random.randint(1000, 9999)) for _ in range(3)]
    found_coords = []

    initial_explanation(my_ship)
    game = True
    trips = 0
    while game == True:
        trips += 1
        chosen_planet = generate_planets(
            my_ship, secret_coords, found_coords, trips)
        game, result = planet_interaction(
            my_ship, chosen_planet, found_coords, trips)
        if game == True:
            my_ship.upgrading_ship()

    leaderboard(my_ship, trips, result, filename="leaderboard.txt", top_n=5)
