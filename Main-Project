# Will have a spaceship and will choose to go to different(Randomly generated planets) and will have to fight aliens and collect resources to upgrade the spaceship.
# The game will have a simple text-based interface(Hopefully) and will be turn-based.
# The player will have to make strategic decisions on which planets to visit, which aliens to fight, and how to manage their resources.


import random


class Planet:
    def __init__(self, name, survival_chance, rewards):
        self.name = name
        self.survival_chance = survival_chance
        self.rewards = rewards


def generate_planets(exp):
    PREFIXES = ["K2", "KMT", "TOI", "WASP", "Kepler"]
    DESIGNATIONS = ["Prime", "Major", "Minor", "Alpha", "Beta", "Gamma"]

    planets = []
    for i in range(0, 3):
        prefix = random.choice(PREFIXES)
        number = random.randint(1, 1000)
        designation = random.choice(DESIGNATIONS)
        name = f"{prefix}-{number} {designation}"

        survival_chance = random.randint(10, 100)
        rewards = (exp//100) * (100-survival_chance) * random.randint(1, 10)

        planets.append(Planet(name, survival_chance, rewards))

        print(
            f"Planet {i+1}: {name} (Survival Chance: {survival_chance} %, Rewards: {rewards})")

    choice = int(
        input("Which planet do you want to visit? (Enter number 1-3): "))
    chosen_planet = planets[choice - 1]

    if chosen_planet:
        print(f"\nHeading to {chosen_planet.name}!")
        return chosen_planet
    else:
        print("\nInvalid choice, defaulted to Option 1.")
        return planets[0]


def planet_interaction(exp, chosen_planet):
    if random.randint(0, 100) > chosen_planet.survival_chance:
        print("You unfortunately failed, your ship has exploded! ")
        # Want to say how many planets were explored and the final score (rewards)
        print(f"You made it to level {exp//100}. ")
        game = False
    elif chosen_planet.survival_chance / 2 < random.randint(0, 100) < chosen_planet.survival_chance:
        print("You just about survived the mission... ")
        print(f"You received {chosen_planet.rewards} rewards. ")
        exp += chosen_planet.rewards
        game = True
    else:
        bonus = random.uniform(0, 0.3)
        print(
            f"This mission went perfect :) so you received {chosen_planet.rewards} rewards")
        print(
            f"You had time for some extra jobs to get an additional {chosen_planet.rewards * bonus :.1f} rewards: ")
        exp += (1 + bonus) * chosen_planet.rewards
        game = True

    return exp, game


if __name__ == "__main__":
    exp = 100
    game = True
    while game == True:
        chosen_planet = generate_planets(exp)
        exp, game = planet_interaction(exp, chosen_planet)
